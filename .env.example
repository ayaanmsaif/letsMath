# Copy to .env and fill in. Real environment variables always take precedence.

# Claude API key (or run `ant auth login` instead). Needed from M2 onward.
ANTHROPIC_API_KEY=

# Only for keys that aren't scoped to a workspace: the workspace ID from the Console (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=

# Tutor model and effort. Sonnet 5 for day-to-day testing to stay inside the testing budget;
# the M6 eval compares it with Opus 5 and Haiku 4.5 and picks the production default.
TUTOR_MODEL=claude-sonnet-5
TUTOR_EFFORT=low

# Cheap model for watch-mode triage.
WATCH_MODEL=claude-haiku-4-5

# Watch mode pauses once a session has spent this much (USD).
SESSION_BUDGET_USD=1.00

# Total API spend allowed for development and testing (USD, all sessions, tracked in .usage/).
# The server refuses Claude calls once this is reached. $5.00 stays under £5 including UK VAT.
DEV_BUDGET_USD=5.00

# 1 = replay scripted tutor responses instead of calling Claude (costs nothing).
TUTOR_MOCK=0

# API server port (the Vite dev server proxies /api here).
PORT=8787
